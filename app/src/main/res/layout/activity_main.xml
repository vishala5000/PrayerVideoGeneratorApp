<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:padding="16dp"
    android:background="#FFFFFF">
    
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Enter Prayers (separate each with a blank line):" 
            android:textSize="18sp" android:textStyle="bold" 
            android:layout_marginBottom="8dp" android:textColor="#000000"/>
        
        <EditText android:id="@+id/etPrayers" android:layout_width="match_parent" android:layout_height="300dp"
            android:hint="Prayer 1...\n\nPrayer 2...\n\nPrayer 3..."
            android:gravity="top" android:inputType="textMultiLine"
            android:textColor="#000000" android:textColorHint="#757575"
            android:background="@android:drawable/edit_text" android:textSize="14sp"/>

        <Button android:id="@+id/btnGenerate" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Generate Separate Videos" android:layout_marginTop="16dp"/>
        
        <ProgressBar android:id="@+id/progressBar" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:visibility="gone" style="?android:attr/progressBarStyleHorizontal"/>
            
        <TextView android:id="@+id/tvStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="Ready." android:textColor="#000000" android:textSize="14sp"/>
            
        <Button android:id="@+id/btnDownloadZip" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Download All as ZIP" android:layout_marginTop="24dp" android:enabled="false"/>
            
    </LinearLayout>
</ScrollView>
